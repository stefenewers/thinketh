# Thinketh backend. Every key is optional: a missing key selects the local
# deterministic fallback for that integration. Never ship these to the app.

# --- Claude (structured inference) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=               # only if the key isn't workspace-scoped (wrkspc_…)
# THINKETH_CLAUDE_MODEL=claude-opus-5
# THINKETH_CLAUDE_EFFORT=medium        # low | medium | high
# THINKETH_CLAUDE_TIMEOUT_MS=20000
# THINKETH_CLAUDE_DELTA=true           # Claude phrasing of the deterministic delta

# --- Backboard (persistent learning memory) ---
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=                # stable assistant for the demo persona (verify:backboard prints one)
# BACKBOARD_LLM_PROVIDER=anthropic     # optional: model for thread messages (Backboard default otherwise)
# BACKBOARD_MODEL=                     # a model name from Backboard's model list

# --- MongoDB Atlas (semantic corpus) ---
MONGODB_URI=
# MONGODB_DB=thinketh
# VOYAGE_API_KEY=                      # optional: embeddings for $vectorSearch

# --- Tiger Data (temporal knowledge history) ---
TIGER_DATABASE_URL=
# TIGER_TLS_INSECURE=false             # HACKGT DEMO ONLY: skip Tiger cert verification on Supabase Edge (Deno rejects Timescale's chain). Remove after the event.

# --- Supabase (auth, profile, flags, integration ids) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# THINKETH_REQUIRE_AUTH=false          # true = reject requests without a valid Supabase session

# --- ElevenLabs (Catch Me Up voice) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- Server ---
# THINKETH_APP_KEY=                    # public demo: every route except /health needs x-thinketh-app-key (the app sends EXPO_PUBLIC_THINKETH_APP_KEY)
# PORT=8787
# THINKETH_DEMO_USER_ID=demo-user
# THINKETH_ALLOW_RESET=true
# THINKETH_ADMIN_TOKEN=                # enables POST /admin/ingest and POST /admin/discovery/run

# --- Identity (see docs/INTEGRATION-NOTES.md, 2026-09-27) ---
# THINKETH_DEMO_IDENTITIES=true        # seeded personas (demo-user, nadani) selectable by header; no-identity requests = demo-user
# THINKETH_TRUST_USER_HEADER=false     # DEVELOPMENT ONLY: accept any x-thinketh-user-id as identity. Never on a shared server.
# THINKETH_DEMO_ALIAS_PREFIX=          # e.g. "audit-": rehearsal clones of the demo persona with isolated history

# --- Durable state + discovery ---
# THINKETH_DATA_DIR=.thinketh-data     # local mirror of app state (resources, rooms, profiles, runs); "off" = memory only
# THINKETH_DISCOVERY_EVERY_MINUTES=0   # >0 runs discovery on the API process (Node server only)
# THINKETH_DISCOVERY_ITEMS_PER_SOURCE=8
# THINKETH_DISCOVERY_MAX_DEVELOPMENTS=4   # Claude normalizations per run (the cost bound)
# THINKETH_DISCOVERY_MAX_AGE_DAYS=21
# THINKETH_DISCOVERY_BUDGET_MS=180000

# Muse: Playground conductor (server-side only; never in the app bundle).
# Without a key and model, the deterministic conductor runs the same flow.
MUSE_API_KEY=
MUSE_MODEL=
# OpenAI-compatible chat completions base URL (we use Meta's Model API with MUSE_MODEL=muse-spark-1.3)
MUSE_API_BASE=
MUSE_TIMEOUT_MS=8000
