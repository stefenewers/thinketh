{
  "expo": {
    "name": "Thinketh",
    "slug": "thinketh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thinketh.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Thinketh uses the microphone when you start a conversation with it.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false,
      "appleTeamId": "4596J38HHC"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D35935",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.thinketh.app",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "thinketh",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9F7F4",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "expo-image"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9bd7d531-aae4-404f-8fdf-c015ecf63aab"
      }
    },
    "owner": "p237"
  }
}
